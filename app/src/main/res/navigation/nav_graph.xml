<?xml version="1.0" encoding="utf-8"?>
<!-- Граф навигации: Start ⇄ Registration (с результатом), Start → Content ⇄ Settings -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startFragment">

    <fragment
        android:id="@+id/startFragment"
        android:name="com.example.androidlab.StartFragment"
        android:label="StartFragment"
        tools:layout="@layout/fragment_start">

        <action
            android:id="@+id/action_start_to_registration"
            app:destination="@id/registrationFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />

        <!-- После входа стартовый экран убирается из стека:
             по "назад" с экрана данных приложение закрывается -->
        <action
            android:id="@+id/action_start_to_content"
            app:destination="@id/contentFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popUpTo="@id/startFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.androidlab.RegistrationFragment"
        android:label="RegistrationFragment"
        tools:layout="@layout/fragment_registration">

        <!-- Логин, который пользователь уже начал вводить на стартовом экране -->
        <argument
            android:name="login"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/contentFragment"
        android:name="com.example.androidlab.ContentFragment"
        android:label="ContentFragment"
        tools:layout="@layout/fragment_content">

        <argument
            android:name="nickname"
            app:argType="string" />

        <action
            android:id="@+id/action_content_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.androidlab.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings">

        <!-- Выход из аккаунта: закрываем все экраны и начинаем со стартового -->
        <action
            android:id="@+id/action_settings_to_start"
            app:destination="@id/startFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
